# ==========================================
# Dependencies
# ==========================================
node_modules/
*/node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Next.js & Frontend Build Outputs
# ==========================================
frontend/.next/
frontend/out/
.next/
out/
build/
dist/
.turbo/

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
**/.env
**/.env.*

# Always preserve example configuration templates
!.env.example
!**/.env.example
!env.example
!**/env.example

# ==========================================
# Backend Uploads & Local Temp Files
# ==========================================
backend/uploads/*
!backend/uploads/.gitkeep
data/
*.log
*.sqlite
scratch_*.js

