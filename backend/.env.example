# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:sua_senha@147.15.99.82:5437/postgres
DB_HOST=147.15.99.82
DB_PORT=5437
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_DIALECT=postgres
DB_SSL=false

# ==========================================
# Server Configuration
# ==========================================
PORT=4000
NODE_ENV=development
API_PUBLIC_BASE_URL=http://localhost:4000

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET=sua_chave_secreta_jwt_super_segura
JWT_EXPIRES_IN=24h

# ==========================================
# CORS Configuration (Origens permitidas separadas por vírgula)
# ==========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:4200

# ==========================================
# File Upload Local
# ==========================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800

# ==========================================
# Google Drive OAuth2 (Opcional - Storage Nuvem)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ==========================================
# Rate Limiting & Logs
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
LOG_LEVEL=info

# ==========================================
# RAG & IA (Futuras Etapas)
# ==========================================
GEMINI_API_KEY=
OPENAI_API_KEY=
